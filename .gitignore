# or read them; the repo never carries them.
data/raw/
data/records/
data/prj2048/
data/partner/
*.EDB
*.e2k
*.$et

# Generated bulk: simulation outputs, trained models, caches
data/generated/
runs/
*.log
*.h5
*.npz
*.pt
*.onnx

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# OS / editor
.DS_Store
.vscode/
.idea/
