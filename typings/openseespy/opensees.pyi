# Types for the few OpenSeesPy commands this repo calls. OpenSeesPy is a compiled
# module with no type information, so pyright can't check calls into it without these.

def wipe() -> None: ...
def model(builder: str, *options: str | int) -> None: ...
def node(tag: int, *coordinates_and_options: float | str) -> None: ...
def fix(tag: int, *constraints: int) -> None: ...
def uniaxialMaterial(material_type: str, tag: int, *arguments: float) -> None: ...
def element(element_type: str, tag: int, *arguments: int | str) -> None: ...
def rayleigh(alpha_mass: float, beta_current: float, beta_initial: float, beta_committed: float) -> None: ...
def timeSeries(series_type: str, tag: int, *arguments: float | str) -> None: ...
def pattern(pattern_type: str, tag: int, direction: int, *arguments: str | int) -> None: ...
def constraints(handler: str) -> None: ...
def numberer(numberer_type: str) -> None: ...
def system(system_type: str) -> None: ...
def test(test_type: str, tolerance: float, max_iterations: int) -> None: ...
def algorithm(algorithm_type: str) -> None: ...
def integrator(integrator_type: str, *arguments: float) -> None: ...
def analysis(analysis_type: str) -> None: ...
def analyze(steps: int, time_step: float) -> int: ...
def nodeDisp(tag: int, dof: int) -> float: ...
